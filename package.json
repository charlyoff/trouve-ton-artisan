{
  "name": "trouve-ton-artisan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/start.js",
    "db:setup": "node scripts/setup-db.mjs",
    "db:local": "node scripts/local-mysql.mjs",
    "test": "node --test tests/*.test.js",
    "test:db": "cross-env TEST_DB=1 node --test tests/database.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sass": "^1.104.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "overrides": {
    "sequelize": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "cross-env": "^10.1.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
