NODE_ENV=development
PORT=3000
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-at-least-32-random-characters
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=trouve_ton_artisan
DB_USER=artisan_reader
DB_PASSWORD=replace-with-a-strong-password
# Used only by the one-time db:setup command, never by the API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_SSL=false
# preview saves .eml files locally. smtp sends through your configured provider.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Trouve ton artisan <no-reply@example.test>
# Set to 1 only behind one trusted reverse proxy. Default: no trusted proxy.
TRUST_PROXY=0
